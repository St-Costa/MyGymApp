#!/usr/bin/env bash
# Runs unit tests before allowing a commit. See docs/CONVENTIONS.md#local-test-gate.
#
# This file is tracked in the repo but git only looks at .git/hooks/, which isn't tracked.
# Install once per clone with:
#   ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
#
# Skip once with: git commit --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# JDK 21 is required — the Gradle daemon does not start on the machine-default JDK 25.
# Honor an explicit JAVA_HOME, otherwise pick up a local JDK 21 install when present.
if [ -z "${JAVA_HOME:-}" ]; then
    for candidate in /usr/lib/jvm/java-21-openjdk-amd64 /usr/lib/jvm/java-21-openjdk "$HOME/.jdks/jdk-21"; do
        if [ -x "$candidate/bin/java" ]; then
            export JAVA_HOME="$candidate"
            break
        fi
    done
fi

echo "pre-commit: running ./gradlew test (JAVA_HOME=${JAVA_HOME:-unset}) ..."
ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}" ./gradlew test --console=plain
